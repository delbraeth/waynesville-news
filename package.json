{
  "name": "waynesville-news",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Waynesville Daily Brief \u2014 hyperlocal news for Waynesville, OH & Warren County (waynesville.news)",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-briefs.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "refresh:weather": "node scripts/fetch-weather.mjs",
    "refresh:headlines": "node scripts/fetch-headlines.mjs",
    "refresh:safety": "node scripts/fetch-prosecutor-press.mjs",
    "refresh:obituaries": "node scripts/fetch-obituaries.mjs",
    "refresh:sports": "node scripts/fetch-sports.mjs",
    "refresh:library": "node scripts/fetch-library-events.mjs",
    "refresh:township": "node scripts/fetch-township-agendas.mjs",
    "refresh:shops": "node scripts/fetch-shops-events.mjs",
    "refresh:village-minutes": "node scripts/fetch-village-minutes.mjs",
    "refresh:fb": "node scripts/fetch-fb-schools.mjs",
    "newsletter:send": "node scripts/send-newsletter.mjs",
    "draft": "node scripts/draft-brief.mjs",
    "check:briefs": "node scripts/check-briefs.mjs",
    "check:staleness": "node scripts/check-staleness.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.0.0",
    "marked": "^18.0.13",
    "pdf-parse": "^2.4.5",
    "puppeteer-core": "^25.8.0",
    "tesseract.js": "^6.0.0"
