---
import { getPublicBriefs } from "../lib/briefs.js";
import site from "../data/site.json";
const year = 2026;
const { isDemoMode } = await getPublicBriefs();
const nl = site.newsletter;
const nlReady = nl && nl.username && nl.username !== "REPLACE_ME";
---
<footer class="site-footer">
  <div class="inner">
    <div class="cols">
      <div>
        <p class="brand">Waynesville Daily Brief</p>
        <p class="muted small">
          Independent, hyperlocal coverage of Waynesville, Corwin &amp; Warren County —
          schools first, plus the events that make this place worth living in.
        </p>
        <p class="small"><strong>Our promise:</strong> every item sourced and linked.
          We’d rather run five true things than fifty scraped ones.</p>
      </div>
      <div>
        <h4>Sections</h4>
        <ul>
          <li><a href="/briefs/">Daily Briefs</a></li>
          <li><a href="/schools/">Schools</a></li>
          <li><a href="/events/">Events &amp; Things to Do</a></li>
          <li><a href="/government/">Local Government</a></li>
          <li><a href="/around-town/">Around Town</a></li>
          <li><a href="/public-safety/">Public Safety</a></li>
        </ul>
      </div>
      <div>
        <h4>The Brief, by email</h4>
        {nlReady ? (
          <>
            <p class="small muted">Free — a note in your inbox when a new brief goes up.</p>
            <form
              class="signup"
              action={`https://buttondown.com/api/emails/embed-subscribe/${nl.username}`}
              method="post"
              target="popupwindow"
              onsubmit={`window.open('https://buttondown.com/${nl.username}','popupwindow')`}
            >
              <input type="email" name="email" placeholder="you@example.com" required />
              <button class="btn" type="submit">Subscribe</button>
            </form>
          </>
        ) : (
          <>
            <p class="small muted">Coming soon — a free email edition.</p>
            <form class="signup" onsubmit="return false;" aria-label="Email signup (coming soon)">
              <input type="email" placeholder="you@example.com" disabled />
              <button class="btn" type="submit" disabled>Notify me</button>
            </form>
          </>
        )}
        <p class="small"><a href="/about/">About &amp; contact</a> · editor@waynesville.news</p>
      </div>
    </div>
    <p class="fine">
      © {year} Waynesville Daily Brief · waynesville.news{isDemoMode ? " · Built as a demo — not yet publishing real news." : ""}
    </p>
  </div>
</footer>
