---
interface Props { title: string; dek?: string; dateLabel: string; href: string; }
const { title, dek, dateLabel, href } = Astro.props;
const submitHref = "mailto:editor@waynesville.news?subject=" + encodeURIComponent("Story or event tip") +
  "&body=" + encodeURIComponent("What's happening:\n\nDate and time (for events):\n\nWhere:\n\nLink or source (if any):\n\nYour name and how to reach you (not published):\n");
---
<div class="featured">
  <p class="kicker">Today’s Brief · {dateLabel}</p>
  <h2>{title}</h2>
  {dek && <p class="dek">{dek}</p>}
  <div class="featured-actions">
    <a class="btn" href={href}>Read today’s brief →</a>
    <a class="btn btn-outline" href={submitHref}>Submit a story or event</a>
  </div>
  <p class="muted small submit-note">Tips go to the editor and are reviewed before anything is published.</p>
</div>
