---
interface Props { dateLine?: string; }
// Last-resort fallback only — Base.astro passes the current edition's date. This
// keeps the masthead from ever showing a stale hardcoded date if used directly.
const { dateLine = new Intl.DateTimeFormat("en-US", {
  weekday: "long", month: "long", day: "numeric", year: "numeric", timeZone: "UTC",
}).format(new Date()) } = Astro.props;

import churchData from "../data/churches.json";
import orgData from "../data/organizations.json";

type Link = { label: string; href: string; cls?: string };
// "Community" groups the reference pages; Churches and Clubs appear only once
// their data files have entries. About and Supporters live in the footer.
const community: Link[] = [
  { label: "Visiting Waynesville", href: "/visit/" },
  { label: "Living in Waynesville", href: "/resources/" },
  churchData.items.length > 0 && { label: "Churches", href: "/churches/" },
  orgData.items.length > 0 && { label: "Clubs & Nonprofits", href: "/community/" },
].filter(Boolean) as Link[];
// Top bar (editor, 2026-11-07): eight items so it fits on one line. The
// news sections share a "News" dropdown, like the Community one.
const news: Link[] = [
  { label: "Stories", href: "/stories/" },
  { label: "Government", href: "/government/" },
  { label: "Public Safety", href: "/public-safety/" },
  { label: "Around Town", href: "/around-town/" },
];
const before: Link[] = [
  { label: "Daily Briefs", href: "/briefs/" },
];
const middle: Link[] = [
  { label: "Events", href: "/events/" },
  { label: "Schools", href: "/schools/" },
  { label: "Directory", href: "/directory/" },
];
const after: Link[] = [
  { label: "Search", href: "/search/" },
  { label: "Subscribe", href: "#subscribe", cls: "nav-subscribe" },
];
// Phone "More" menu: everything, Community pages included, plus About.
const all: Link[] = [...before, ...news, ...middle, ...community, { label: "Supporters", href: "/supporters/" }, { label: "About", href: "/about/" }, ...after];
---
<header class="masthead">
  <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode" title="Light or dark">☾</button>
  <p class="wordmark"><a href="/">Waynesville News</a></p>
  <p class="tagline">Waynesville, two square miles, surrounded by reality since 1797.</p>
  <p class="dateline">{dateLine} &nbsp;·&nbsp; waynesville.news</p>
</header>
<nav class="mainnav" aria-label="Sections">
  <ul class="nav-full">
    {before.map((n) => <li><a href={n.href} class={n.cls}>{n.label}</a></li>)}
    <li>
      <details class="nav-drop">
        <summary>News <span aria-hidden="true">▾</span></summary>
        <ul>
          {news.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </details>
    </li>
    {middle.map((n) => <li><a href={n.href} class={n.cls}>{n.label}</a></li>)}
    <li>
      <details class="nav-drop">
        <summary>Community <span aria-hidden="true">▾</span></summary>
        <ul>
          {community.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </details>
    </li>
    {after.map((n) => <li><a href={n.href} class={n.cls}>{n.label}</a></li>)}
  </ul>
  {/* Phones: three most-used links plus a "More" menu with everything. Pure
      HTML <details>, so it works without JavaScript and with screen readers. */}
  <div class="nav-compact">
    <a href="/briefs/">Briefs</a>
    <a href="/events/">Events</a>
    <a href="/directory/">Directory</a>
    <details class="nav-more">
      <summary><span aria-hidden="true">☰</span> More</summary>
      <ul>
        {all.map((n) => <li><a href={n.href} class={n.cls}>{n.label}</a></li>)}
      </ul>
    </details>
  </div>
</nav>
<script is:inline>
// Close the Community dropdown and the phone "More" menu on a click outside,
// on Escape, or when keyboard focus moves out of them (so an open menu never
// covers the next focused link).
var MENUS = "details.nav-drop[open], details.nav-more[open]";
document.addEventListener("click", function (e) {
  document.querySelectorAll(MENUS).forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute("open"); });
});
document.addEventListener("keydown", function (e) {
  if (e.key === "Escape") document.querySelectorAll(MENUS).forEach(function (d) { d.removeAttribute("open"); d.querySelector("summary").focus(); });
});
document.addEventListener("focusout", function (e) {
  document.querySelectorAll(MENUS).forEach(function (d) { if (d.contains(e.target) && e.relatedTarget && !d.contains(e.relatedTarget)) d.removeAttribute("open"); });
});
(function () {
  var b = document.getElementById("theme-toggle");
  if (!b) return;
  var root = document.documentElement;
  var mq = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  function isDark() { return root.dataset.theme ? root.dataset.theme === "dark" : !!(mq && mq.matches); }
  function paint() {
    var d = isDark();
    b.textContent = d ? "\u2600" : "\u263E";
    b.setAttribute("aria-label", d ? "Switch to light mode" : "Switch to dark mode");
  }
  b.addEventListener("click", function () {
    var next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch (e) {}
    paint();
  });
  if (mq && mq.addEventListener) mq.addEventListener("change", paint);
  paint();
})();
</script>
