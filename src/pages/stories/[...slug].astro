---
import Base from "../../layouts/Base.astro";
import SubscribeBox from "../../components/SubscribeBox.astro";
import { getCollection, render } from "astro:content";
import { newsArticle } from "../../lib/structuredData.js";

export async function getStaticPaths() {
  const stories = (await getCollection("stories")).filter((s) => s.data.published);
  return stories.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const dateFmt = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<Base
  title={`${d.title} · Waynesville News`}
  description={d.dek}
  image={d.image}
  imageAlt={d.imageAlt}
  ogType="article"
  published={d.date}
  dateLine={dateFmt.format(d.date)}
  showInfoBar={false}
  jsonLd={newsArticle({ title: d.title, dek: d.dek, date: d.date, updated: d.updated, url: Astro.url.pathname, image: d.image })}
>
  <article class="reading story">
    <p class="kicker">{d.section ?? "Story"}</p>
    <h1>{d.title}</h1>
    {d.dek && <p class="dek">{d.dek}</p>}
    <p class="story-meta">
      {d.byline} · {dateFmt.format(d.date)}
      {d.updated && <> · Updated {dateFmt.format(d.updated)}</>}
    </p>
    {d.image && (
      <figure class="story-figure">
        <img src={d.image} alt={d.imageAlt ?? ""} loading="eager" />
        {d.imageCredit && <figcaption>{d.imageCredit}</figcaption>}
      </figure>
    )}
    <div class="prose" data-pagefind-body>
      <span data-pagefind-meta="date" hidden>{dateFmt.format(d.date)}</span>
      <span data-pagefind-sort="date" hidden>{d.date.toISOString().slice(0, 10)}</span>
      <span data-pagefind-filter="type" hidden>Story</span>
      <Content />
    </div>
    <SubscribeBox />
    <p class="small">Spot a mistake? <a href={`/corrections/submit/?page=${encodeURIComponent(`/stories/${entry.id}/`)}`}>Report a correction</a>. Know something we should look into? <a href="/tips/">Send a tip</a>.</p>
    <p class="small"><a href="/stories/">← All stories</a></p>
  </article>
</Base>
