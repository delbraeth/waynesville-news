---
import Base from "../layouts/Base.astro";
import directory from "../data/directory.json";
import supporters from "../data/supporters.json";

type Item = {
  id: string; name: string; location?: string; phone?: string; website?: string; email?: string;
  social?: { facebook?: string; instagram?: string; tiktok?: string; airbnb?: string };
  about?: string; sections: string[]; kinds?: string[]; local?: boolean; source?: string; from?: string;
};

const items = (directory.items ?? []) as Item[];
const sections = (directory.sections ?? []) as { id: string; label: string }[];

// Waynesville-area businesses first, then alphabetical.
const byLocalThenName = (a: Item, b: Item) =>
  Number(!!b.local) - Number(!!a.local) || a.name.localeCompare(b.name);

const groups = sections
  .map((s) => ({ ...s, items: items.filter((i) => i.sections.includes(s.id)).sort(byLocalThenName) }))
  .filter((g) => g.items.length);

// Chamber sub-categories like "Construction" or "Services" add nothing on a card.
const GENERIC = new Set(["construction", "services", "other services/misc", "retail/wholesale", "custom", "restaurant"]);
const tags = (i: Item) => (i.kinds ?? []).filter((k) => !GENERIC.has(k.toLowerCase())).slice(0, 4);

const telHref = (p: string) => "tel:" + p.replace(/[^\d+]/g, "");
const SOCIAL_LABELS: [keyof NonNullable<Item["social"]>, string][] = [["facebook", "Facebook"], ["instagram", "Instagram"], ["tiktok", "TikTok"], ["airbnb", "Airbnb"]];
const socials = (i: Item) => SOCIAL_LABELS.filter(([k]) => i.social?.[k]).map(([k, label]) => ({ href: i.social![k]!, label }));
// The business name links to its website, or to its first social page if it has no site.
const primaryLink = (i: Item) => i.website || socials(i)[0]?.href || "";
const prettyUrl = (u: string) => u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/.*$/, "");
// Section labels are searchable too, so "gift shop" finds shops tagged "Gifts".
const sectionLabel = (id: string) => sections.find((s) => s.id === id)?.label ?? "";
const searchText = (i: Item) =>
  [i.name, i.about, i.location, ...(i.kinds ?? []), ...i.sections.map(sectionLabel)].join(" ").toLowerCase();

// Each listing gets a shareable anchor (/directory/#butter-churn-cafe). A
// listing filed in two sections gets the id in the first one only.
const slug = (name: string) => name.toLowerCase().replace(/&/g, " and ").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const anchorAt = new Map<string, string>();
const correctMail = (name: string) =>
  "mailto:editor@waynesville.news?subject=" + encodeURIComponent(`Directory correction: ${name}`) +
  "&body=" + encodeURIComponent("What should change (hours, phone, website, description, address, closed/moved)?\n\n");

const updated = directory.updated
  ? new Date(directory.updated).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "America/New_York" })
  : "";
const localCount = items.filter((i) => i.local).length;

// Businesses that help fund the Brief (src/data/supporters.json) get a labeled
// "Supporter" badge. Matched by name, ignoring LLC/Inc/punctuation; a supporter
// entry can set `directoryName` when its listing uses a different name. The
// badge never changes a listing's position — placement isn't for sale.
const nameKey = (n = "") =>
  n.toLowerCase().replace(/&/g, "and").replace(/\b(llc|inc|co|corp|ltd|the)\b\.?/g, "").replace(/[^a-z0-9]/g, "");
const supporterKeys = new Set(
  ((supporters.items ?? []) as { name?: string; directoryName?: string }[])
    .filter((s) => s && s.name)
    .map((s) => nameKey(s.directoryName || s.name))
);
const isSupporter = (i: Item) => supporterKeys.has(nameKey(i.name));
const supporterCount = items.filter(isSupporter).length;
const listMail = "mailto:editor@waynesville.news?subject=" + encodeURIComponent("Business directory listing");
import churchData from "../data/churches.json";
const hasChurches = churchData.items.length > 0;
---
<Base
  title="Local Business Directory · Waynesville News"
  description="Plumbers, electricians, landscapers, accountants, salons, shops and restaurants serving Waynesville, Ohio — a free local business directory."
  showInfoBar={false}
>
  <div class="reading">
    <p class="kicker">Local business</p>
    <h1>Business Directory</h1>
    <p class="dek">
      Where to eat and who to call in and around Waynesville — restaurants first, then trades and home
      services, health, professional services and shops. {items.length} businesses, {localCount} of them in the Waynesville area.
    </p>

    <div class="callout">
      <strong>Free to be listed, and not an endorsement.</strong> Listings come from
      local businesses we've confirmed on their own websites and ones that ask to be added. Nobody pays for placement, and a listing says nothing about
      quality — always check licensing, insurance and reviews before hiring.
      {supporterCount > 0 && (
        <>Businesses marked <span class="dir-supporter">★ Supporter</span> help fund the Brief; that
        doesn't change where they appear or what we cover. <a href="/supporters/#business">Become one</a>.</>
      )}
      Missing, moved or out of business? <a href={listMail}>Email the editor</a>.
    </div>

    <form class="dir-tools" role="search" onsubmit="return false">
      <label class="dir-search">
        <span class="visually-hidden">Search the directory</span>
        <input id="dir-q" type="search" placeholder="Search: plumber, tax, salon, pizza…" autocomplete="off" />
      </label>
      <label class="dir-local">
        <input id="dir-local" type="checkbox" /> Waynesville area only
      </label>
      {supporterCount > 0 && (
        <label class="dir-local">
          <input id="dir-supp" type="checkbox" /> Supporters only
        </label>
      )}
    </form>

    <nav class="dir-jump" aria-label="Directory sections">
      {groups.map((g) => <a href={`#${g.id}`} data-jump={g.id}>{g.label} <span class="muted">{g.items.length}</span></a>)}
    </nav>

    <p id="dir-none" class="muted" hidden>No listings match. Try a shorter search, or <a href={listMail}>tell us who's missing</a>.</p>

    {groups.map((g) => (
      <section class="dir-group" id={g.id} data-group={g.id}>
        <h2>{g.label}</h2>
        {g.id === "faith" && hasChurches && (
          <p class="small"><strong><a href="/churches/">See the church directory</a></strong> for every congregation in the area, with service times and community ministries.</p>
        )}
        {g.id === "faith" && (
          <p class="small muted">Holding a supper, concert, bazaar or service open to everyone? <a href="/events/#add-event">Send it for the events calendar</a>.</p>
        )}
        <ul class="directory">
          {g.items.map((i) => {
            const s = slug(i.name);
            const owns = !anchorAt.has(s) || anchorAt.get(s) === g.id;
            if (!anchorAt.has(s)) anchorAt.set(s, g.id);
            return (
            <li id={owns ? s : undefined} data-search={searchText(i)} data-local={i.local ? "1" : "0"} data-supporter={isSupporter(i) ? "1" : "0"}>
              <div class="dir-name">
                {primaryLink(i) ? <a href={primaryLink(i)} target="_blank" rel="noopener">{i.name}</a> : i.name}
                {isSupporter(i) && <a class="dir-supporter" href="/supporters/" title="This business helps fund the Waynesville News">★ Supporter</a>}
                {i.local && <span class="dir-badge">Waynesville area</span>}
              </div>
              {tags(i).length > 0 && <div class="dir-kinds">{tags(i).join(" · ")}</div>}
              {i.about && <p class="dir-about">{i.about}</p>}
              <div class="dir-contact">
                {i.location && <span>{i.location}</span>}
                {i.phone && <a href={telHref(i.phone)}>{i.phone}</a>}
                {i.email && <a href={"mailto:" + i.email}>{i.email}</a>}
                {i.website && <a href={i.website} target="_blank" rel="noopener">{prettyUrl(i.website)}</a>}
                {socials(i).map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
              </div>
              <div class="dir-tools">
                <a href={`#${s}`} aria-label={`Link to ${i.name}`}>Link to this listing</a>
                <a href={correctMail(i.name)}>Correct this listing</a>
              </div>
            </li>
            );
          })}
        </ul>
      </section>
    ))}

    <div class="sp-join">
      <h3>Add or fix a listing</h3>
      <p>
        Run a business that serves Waynesville, Corwin, Harveysburg or the rest of Wayne Township? Listings are free.
        <a href={listMail}>Email the editor</a> with your business name, what you do, your town, phone, and website or social pages.
      </p>
      <p class="small muted">
        Want to help fund the Brief? <a href="/supporters/#business">Become a business supporter</a> and your listing gets a ★ Supporter badge.
        {updated && <> Directory last refreshed {updated}.</>}
      </p>
    </div>
  </div>
</Base>

<script is:inline>
(() => {
  const q = document.getElementById("dir-q");
  const local = document.getElementById("dir-local");
  const supp = document.getElementById("dir-supp");
  const none = document.getElementById("dir-none");
  // Read every listing once up front, so filtering is plain array work and the
  // page only touches the DOM for listings whose visibility actually changes.
  const groups = [...document.querySelectorAll(".dir-group")].map((g) => {
    const jump = document.querySelector(`[data-jump="${g.id}"]`);
    return {
      el: g,
      jump,
      count: jump ? jump.querySelector("span") : null,
      items: [...g.querySelectorAll("li")].map((li) => ({
        li, hay: li.dataset.search || "", local: li.dataset.local === "1", supp: li.dataset.supporter === "1", shown: true,
      })),
    };
  });
  const apply = () => {
    // Match each word anywhere, ignoring a plural "s" ("gifts" finds "gift").
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean).map((t) => (t.length > 3 ? t.replace(/s$/, "") : t));
    const onlyLocal = local.checked;
    const onlySupp = !!(supp && supp.checked);
    let total = 0;
    for (const g of groups) {
      let shown = 0;
      for (const it of g.items) {
        const ok = (!onlyLocal || it.local) && (!onlySupp || it.supp) && terms.every((t) => it.hay.includes(t));
        if (ok !== it.shown) { it.li.hidden = !ok; it.shown = ok; }
        if (ok) shown++;
      }
      g.el.hidden = shown === 0;
      if (g.jump) {
        g.jump.hidden = shown === 0;
        if (g.count) g.count.textContent = String(shown);
      }
      total += shown;
    }
    none.hidden = total !== 0;
  };
  // Typing waits for a short pause before filtering, so each keystroke stays instant.
  let timer;
  q.addEventListener("input", () => { clearTimeout(timer); timer = setTimeout(apply, 150); });
  local.addEventListener("change", apply);
  if (supp) supp.addEventListener("change", apply);
})();
</script>
