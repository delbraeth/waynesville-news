---
import Base from "../layouts/Base.astro";
import supporters from "../data/supporters.json";
import site from "../data/site.json";

const patreonUrl = site.patreon?.url?.trim() || "";
const tier = site.businessSupport ?? {};
const tierPrice = tier.price?.trim() || "";
const tierUrl = tier.url?.trim() || patreonUrl;
const joinMail = "mailto:editor@waynesville.news?subject=" + encodeURIComponent("Business supporter listing");
const items = (supporters.items ?? []).filter((s) => s && s.name);
const telHref = (p: string) => "tel:" + p.replace(/[^\d+]/g, "");
const prettyUrl = (u: string) => u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---
<Base
  title="Supporters · Waynesville Daily Brief"
  description="The local businesses that help keep the Waynesville Daily Brief free and independent."
  showInfoBar={false}
>
  <div class="reading">
    <p class="kicker">Local business</p>
    <h1>Supporters</h1>
    <p class="dek">The local businesses that help keep the Daily Brief free and independent.</p>

    <div class="callout">
      <strong>How this works.</strong> Supporters back independent local news for Waynesville.
      They have no say in what we cover or how — coverage decisions are the editor's alone,
      and supporting the Brief never buys a story. This is a directory, not an endorsement.
    </div>

    {items.length === 0 ? (
      <p class="muted" style="margin-top:1.5rem;">Our first business supporters will be listed here soon.</p>
    ) : (
      <ul class="supporters">
        {items.map((s) => (
          <li>
            <div class="sp-name">
              {s.website ? <a href={s.website} target="_blank" rel="noopener">{s.name}</a> : s.name}
            </div>
            {s.what && <div class="sp-what">{s.what}</div>}
            {(s.phone || s.website) && (
              <div class="sp-contact">
                {s.phone && <a href={telHref(s.phone)}>{s.phone}</a>}
                {s.phone && s.website && <span class="muted"> · </span>}
                {s.website && <a href={s.website} target="_blank" rel="noopener">{prettyUrl(s.website)}</a>}
              </div>
            )}
          </li>
        ))}
      </ul>
    )}

    <div class="sp-join" id="business">
      <h3>Become a business supporter{tierPrice && <> — {tierPrice}</>}</h3>
      <p>
        Help keep independent local news going in Waynesville. Business supporters get:
      </p>
      <ul>
        <li>A listing on this page: your business name, what you do, phone and website.</li>
        <li>A <span class="dir-supporter">★ Supporter</span> badge on your listing in the <a href="/directory/">Business Directory</a>.</li>
        <li>Your name in the "Supported by" line at the bottom of every page, if you'd like.</li>
      </ul>
      <p>
        What it doesn't buy: coverage, placement or influence. Supporters appear in the directory in the same
        order as everyone else, and the editor alone decides what the Brief covers.
      </p>
      <p>
        {tierUrl
          ? <><a class="sp-cta" href={tierUrl} target="_blank" rel="noopener">Become a business supporter →</a><br /></>
          : null}
        <span class="small">
          {tierUrl ? "After you join, " : "To join, "}<a href={joinMail}>email the editor</a> your business name,
          a one-line description, phone and website, and whether you'd like to be in the footer.
        </span>
      </p>
    </div>

    {patreonUrl && (
      <div class="sp-join">
        <h3>Support the Brief as a reader</h3>
        <p>
          The Daily Brief is free to read and free by email. If it's useful to you, you can chip in
          a few dollars a month on <a href={patreonUrl} target="_blank" rel="noopener">Patreon</a>.
          Patrons don't get a say in coverage either. Every reader gets the same brief.
        </p>
      </div>
    )}

  </div>
</Base>
