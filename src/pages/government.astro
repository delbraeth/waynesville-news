---
import Base from "../layouts/Base.astro";
import SectionFeed from "../components/SectionFeed.astro";
import { sectionFeed } from "../lib/sections.js";

const sources = [
  { name: "Village of Waynesville — Meetings", href: "https://www.villageofwaynesville.org/meetings/", what: "council agendas & minutes" },
  { name: "Village of Waynesville — News", href: "https://www.villageofwaynesville.org/news/", what: "village announcements" },
  { name: "Warren County Commissioners", href: "https://commissioners.warrencountyohio.gov/News/AgendaMinutes/Index", what: "agendas, minutes, resolutions" },
  { name: "North Warren County Transportation Plan", href: "https://northwarrencountytransportationplan-burgessniple.hub.arcgis.com", what: "I-75 to I-71 connection options, priority intersections, public meetings" },
];

const items = await sectionFeed(["Local government"], { limit: 20 });
---
<Base title="Local Government · Waynesville Daily Brief" showInfoBar={false}>
  <SectionFeed
    title="Local Government"
    kicker="Section"
    intro="Village council and county commission, summarized in plain English and linked to the agenda or minutes — a running record from every brief."
    items={items}
    sources={sources}
  />
</Base>
