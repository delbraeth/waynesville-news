---
import Base from "../../layouts/Base.astro";
import BriefCard from "../../components/BriefCard.astro";
import { getPublicBriefs, recentBriefs, ARCHIVE_DAYS } from "../../lib/briefs.js";

const { briefs: allBriefs, isDemoMode } = await getPublicBriefs();
const briefs = isDemoMode ? allBriefs : recentBriefs(allBriefs);
const dateFmt = new Intl.DateTimeFormat("en-US", {
  weekday: "long", month: "long", day: "numeric", year: "numeric",
});
---
<Base title="Daily Briefs · Waynesville Daily Brief" showInfoBar={false}>
  <div class="reading">
    <p class="kicker">Archive</p>
    <h1>Daily Briefs</h1>
    <p class="dek">Editions from the last {ARCHIVE_DAYS} days, most recent first.</p>
    {briefs.map((b) => (
      <BriefCard
        dateLabel={dateFmt.format(b.data.date)}
        title={b.data.title}
        dek={b.data.dek}
        href={`/briefs/${b.id}/`}
      />
    ))}
  </div>
</Base>
