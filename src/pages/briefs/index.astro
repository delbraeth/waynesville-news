---
import Base from "../../layouts/Base.astro";
import BriefCard from "../../components/BriefCard.astro";
import { getCollection } from "astro:content";

const briefs = (await getCollection("briefs"))
  .filter((b) => b.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const dateFmt = new Intl.DateTimeFormat("en-US", {
  weekday: "long", month: "long", day: "numeric", year: "numeric",
});
---
<Base title="Daily Briefs · Waynesville Daily Brief" showInfoBar={false}>
  <div class="reading">
    <p class="kicker">Archive</p>
    <h1>Daily Briefs</h1>
    <p class="dek">Every weekday edition, most recent first.</p>
    {briefs.map((b) => (
      <BriefCard
        dateLabel={dateFmt.format(b.data.date)}
        title={b.data.title}
        dek={b.data.dek}
        href={`/briefs/${b.id}/`}
      />
    ))}
  </div>
</Base>
