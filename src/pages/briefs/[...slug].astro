---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import site from "../../data/site.json";
import SubscribeBox from "../../components/SubscribeBox.astro";
import audioIndex from "../../data/audio-index.json";
import audioCfg from "../../data/audio.json";
import { newsArticle } from "../../lib/structuredData.js";

export async function getStaticPaths() {
  const briefs = (await getCollection("briefs")).filter((b) => b.data.published);
  return briefs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const patreonUrl = site.patreon?.url?.trim() || "";
const audio = (audioIndex.items as Record<string, { url: string; seconds?: number; sponsor?: string }>)[entry.id];
const audioLen = audio?.seconds ? `${Math.floor(audio.seconds / 60)}:${String(audio.seconds % 60).padStart(2, "0")}` : "";

const pod = audioCfg.podcast ?? {};
const podLinks = [
  pod.apple && { href: pod.apple, label: "Apple Podcasts" },
  pod.spotify && { href: pod.spotify, label: "Spotify" },
  pod.youtube && { href: pod.youtube, label: "YouTube" },
].filter(Boolean) as { href: string; label: string }[];

const dateFmt = new Intl.DateTimeFormat("en-US", {
  weekday: "long", month: "long", day: "numeric", year: "numeric",
});
---
<Base
  title={`${entry.data.title} · Waynesville News`}
  description={entry.data.dek}
  ogType="article"
  published={entry.data.date}
  dateLine={dateFmt.format(entry.data.date)}
  showInfoBar={false}
  jsonLd={entry.data.demo ? undefined : newsArticle({ title: entry.data.title, dek: entry.data.dek, date: entry.data.date, url: Astro.url.pathname })}
>
  <div class="reading">
    <p class="kicker">Daily Brief · {dateFmt.format(entry.data.date)}</p>
    <h1>{entry.data.title}</h1>
    {entry.data.dek && <p class="dek">{entry.data.dek}</p>}
    {entry.data.demo && (
      <div class="callout">
        <strong>Sample edition.</strong> Layout only — no real names, quotes, or claims are invented.
      </div>
    )}
    {audio && !entry.data.demo && (
      <div class="brief-audio" id="listen">
        <p class="brief-audio-label">🎧 Listen to this brief{audioLen && <> <span class="muted">({audioLen})</span></>}</p>
        <audio controls preload="none" src={audio.url}></audio>
        {audio.sponsor && <p class="small brief-audio-sub">Today's audio brief is supported by <a href="/supporters/">{audio.sponsor}</a>.</p>}
        <p class="small muted brief-audio-sub">Get it every morning as a podcast:{podLinks.map((l) => <> <a href={l.href} target="_blank" rel="noopener">{l.label}</a> ·</>)} <a href="/podcast.xml">podcast feed</a></p>
      </div>
    )}
    {!entry.data.demo && <SubscribeBox />}
    <div class="prose" data-pagefind-body>
      <span data-pagefind-meta="date" hidden>{dateFmt.format(entry.data.date)}</span>
      <span data-pagefind-sort="date" hidden>{entry.data.date.toISOString().slice(0, 10)}</span>
      <span data-pagefind-filter="type" hidden>Daily brief</span>
      <Content />
    </div>
    {patreonUrl && !entry.data.demo && (
      <div class="callout">
        <strong>Find the Brief useful?</strong> It's free and independent.
        <a href={patreonUrl} target="_blank" rel="noopener">Support it on Patreon</a>.
      </div>
    )}
    {!entry.data.demo && (
      <p class="small brief-howmade">
        <strong>How this brief is made:</strong> drafted with AI from the sources linked above and published
        without a line-by-line human review. <a href="/about/#how">More about how it's made</a>.
        Spot a mistake? <a href={`/corrections/submit/?page=${encodeURIComponent(`/briefs/${entry.id}/`)}`}>Report a correction</a>.
      </p>
    )}
    <p class="small"><a href="/briefs/">← All briefs</a></p>
  </div>
</Base>
