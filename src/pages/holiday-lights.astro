---
import Base from "../layouts/Base.astro";
import lights from "../data/holiday-lights.json";
import { currentDisplays, holidayEvents } from "../lib/holiday.js";

type Display = {
  name: string; tier: "local" | "county" | "drive"; kind?: string; location?: string; town?: string;
  startDate?: string; endDate?: string; dates2026Confirmed?: boolean; when?: string; price?: string;
  about?: string; website?: string; source?: string;
};

const displays = currentDisplays() as Display[];
const events = holidayEvents();

const TIERS = [
  { id: "local", label: "In and around Waynesville" },
  { id: "county", label: "Around Warren County" },
  { id: "drive", label: "Worth the drive" },
];

// Dated displays first, soonest opening first; then ones still waiting on dates.
const order = (a: Display, b: Display) =>
  Number(!a.startDate) - Number(!b.startDate) ||
  (a.startDate ?? "").localeCompare(b.startDate ?? "") ||
  a.name.localeCompare(b.name);

const groups = TIERS
  .map((t) => ({ ...t, items: displays.filter((d) => d.tier === t.id).sort(order) }))
  .filter((g) => g.items.length);

const dayFmt = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const fmt = (iso: string) => dayFmt.format(new Date(iso + "T12:00:00Z"));
const dateRange = (d: Display) =>
  d.startDate && d.endDate ? `${fmt(d.startDate)} – ${fmt(d.endDate)}`
  : d.startDate ? `Opens ${fmt(d.startDate)}`
  : "";

const year = lights.season?.label ?? "";
// Festive header: a draped string of bulbs. Positions follow a gentle sag
// between hang points so the wire reads as a real light string.
const BULB_COLORS = ["#ff4d4d", "#ffd23f", "#3ddc84", "#4dabff", "#ff8fd8"];
const W = 600, SPANS = 4, PER_SPAN = 5;
const sag = (x: number) => {
  const span = W / SPANS, t = (x % span) / span;
  return 10 + 22 * Math.sin(Math.PI * t);
};
const wire = Array.from({ length: 121 }, (_, i) => {
  const x = (i / 120) * W;
  return `${i ? "L" : "M"}${x.toFixed(1)},${sag(x === W ? W - 0.01 : x).toFixed(1)}`;
}).join(" ");
const bulbs = Array.from({ length: SPANS * PER_SPAN }, (_, i) => {
  const x = (W / (SPANS * PER_SPAN)) * (i + 0.5);
  return { x, y: sag(x), color: BULB_COLORS[i % BULB_COLORS.length], delay: ((i * 7) % 10) / 5 };
});

const submitMail = "mailto:editor@waynesville.news?subject=" + encodeURIComponent("Holiday lights listing");
---
<Base
  title="Holiday Lights Guide · Waynesville News"
  description="Christmas light displays in and around Waynesville, Ohio: drive-through shows, park light festivals and village displays, with dates, hours and prices."
  showInfoBar={false}
>
  <div class="reading">
    <header class="hl-hero">
      <svg class="hl-string" viewBox={`0 0 ${W} 52`} preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <filter id="hl-glow" x="-200%" y="-100%" width="500%" height="300%">
            <feGaussianBlur stdDeviation="3" result="b" />
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
        </defs>
        <path d={wire} fill="none" stroke="#2d4a2f" stroke-width="2" />
        {bulbs.map((b) => (
          <g transform={`translate(${b.x.toFixed(1)} ${b.y.toFixed(1)})`}>
            <rect x="-3" y="0" width="6" height="5" rx="1" fill="#556b4f" />
            <ellipse class="hl-bulb" cx="0" cy="12" rx="5" ry="8" fill={b.color}
              filter="url(#hl-glow)" style={`animation-delay:${b.delay}s`} />
          </g>
        ))}
      </svg>
      <div class="hl-hero-text">
        <p class="hl-kicker">Holidays {year}</p>
        <h1>Holiday Lights Guide</h1>
        <p class="hl-dek">
          Christmas light displays in and around Waynesville — close to home first, then around Warren County,
          then the big shows worth a drive.
        </p>
      </div>
    </header>

    <p class="callout">
      Dates, hours and prices are as each organizer posts them. Many haven't announced {year} details yet; those
      are marked, and we'll update them as they're posted. Check the display's own site before you go — weather
      can close outdoor shows.
    </p>

    {groups.length === 0 && (
      <p class="muted">We're gathering this year's displays now. Check back soon, or <a href={submitMail}>tell us about one</a>.</p>
    )}

    {groups.map((g) => (
      <section class="dir-group">
        <h2>{g.label}</h2>
        <ul class="directory">
          {g.items.map((d) => (
            <li>
              <div class="dir-name">
                {d.website ? <a href={d.website} target="_blank" rel="noopener">{d.name}</a> : d.name}
                {d.kind && <span class="dir-badge">{d.kind}</span>}
              </div>
              <div class="dir-kinds">
                {[d.town, dateRange(d)].filter(Boolean).join(" · ")}
                {d.dates2026Confirmed === false && <span class="hl-pending"> · {year} dates not yet announced</span>}
              </div>
              {d.about && <p class="dir-about">{d.about}</p>}
              <div class="dir-contact">
                {d.when && <span>{d.when}</span>}
                {d.price && <span>{d.price}</span>}
              </div>
              {d.location && <div class="dir-contact"><span>{d.location}</span></div>}
            </li>
          ))}
        </ul>
      </section>
    ))}

    {events.length > 0 && (
      <section class="dir-group">
        <h2>Holiday events</h2>
        <ul class="events">
          {events.map((e) => (
            <li>
              <div class="date">{e.dateLabel}</div>
              <div>
                <a class="ev-title" href={e.source} target="_blank" rel="noopener">{e.title}</a>
                <div class="ev-meta">{e.venue}{e.note ? ` · ${e.note}` : ""}</div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="sp-join">
      <h3>Know a display we're missing?</h3>
      <p>
        <a href={submitMail}>Email the editor</a> with the name, place, dates and a link. Decorating your own house?
        We list a home display only with the owner's permission, and we never publish a homeowner's name.
      </p>
      <p><a class="more" href="/events/">Full events calendar →</a></p>
    </div>
  </div>
</Base>

<style>
  /* Night-sky banner. Fixed colors (not theme tokens): it is a picture of a
     winter night in both light and dark mode, and the cream text keeps
     well over 7:1 contrast on the navy. */
  .hl-hero {
    position: relative;
    margin: 0 0 1.5rem;
    padding: 3.4rem 1.25rem 1.6rem;
    border-radius: 12px;
    overflow: hidden;
    color: #fbf6ea;
    background:
      linear-gradient(180deg, #0f1d3a 0%, #172b52 60%, #1f3a5f 100%);
    box-shadow: inset 0 -18px 30px -18px rgba(255,255,255,.18);
  }
  .hl-string {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 52px;
    overflow: visible;
  }
  .hl-bulb {
    animation: hl-twinkle 2s ease-in-out infinite;
  }
  @keyframes hl-twinkle {
    0%, 100% { opacity: 1; }
    50% { opacity: .45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hl-bulb { animation: none; }
  }
  .hl-hero-text { position: relative; }
  .hl-kicker {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: .09em;
    font-size: .78rem;
    font-weight: 600;
    color: #ffd23f;
    margin: 0 0 .35rem;
  }
  .hl-hero h1 {
    color: #fbf6ea;
    margin: 0 0 .5rem;
    text-shadow: 0 0 18px rgba(255, 210, 63, .35);
  }
  .hl-dek {
    font-family: var(--font-serif);
    font-size: 1.12rem;
    color: #dfe6f2;
    margin: 0;
  }
</style>
