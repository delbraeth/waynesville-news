---
import Base from "../layouts/Base.astro";
import SectionFeed from "../components/SectionFeed.astro";
import { sectionFeed } from "../lib/sections.js";

const sources = [
  { name: "Warren County Sheriff", href: "https://sheriff.warrencountyohio.gov/", what: "media releases, alerts" },
  { name: "Warren County Prosecutor — Press", href: "https://prosecutor.warrencountyohio.gov/Public/Press/Index", what: "charges, case outcomes" },
  { name: "Warren County EMA — Everbridge alerts", href: "https://warrencountyema.com/", what: "severe-weather, road-closure & emergency notifications" },
];

const items = await sectionFeed(["Public safety"], { limit: 20 });
---
<Base title="Public Safety · Waynesville Daily Brief" showInfoBar={false}>
  <SectionFeed
    title="Public Safety"
    kicker="Section · Handle With Care"
    intro="Advisories, road and weather alerts, and case outcomes, republished from the Warren County Prosecutor's Office and Sheriff with a link to each official release. Charges are allegations, not convictions."
    items={items}
    sources={sources}
  />
</Base>
