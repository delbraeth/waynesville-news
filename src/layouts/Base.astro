---
import "../styles/global.css";
import DemoBanner from "../components/DemoBanner.astro";
import Masthead from "../components/Masthead.astro";
import InfoBar from "../components/InfoBar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getPublicBriefs } from "../lib/briefs.js";
import { ldJson } from "../lib/structuredData.js";

const { briefs, isDemoMode } = await getPublicBriefs();

interface Props {
  title?: string;
  description?: string;
  dateLine?: string;
  showInfoBar?: boolean;
  image?: string;      // share image (path under /public); defaults to /og.png
  imageAlt?: string;
  ogType?: "website" | "article";
  published?: Date;    // article publish date, for share cards
  jsonLd?: object | object[]; // schema.org structured data (src/lib/structuredData.js)
}
const {
  title = "Waynesville News",
  description = "Hyperlocal daily news for Waynesville, OH, Corwin & Warren County — schools, government, and the events that make this place worth living in.",
  dateLine,
  showInfoBar = true,
  image,
  imageAlt,
  ogType = "website",
  published,
  jsonLd,
} = Astro.props;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Masthead date = the current edition (latest published brief), the SAME on every
// page. Falls back to the build date before any brief exists. Formatted in UTC so
// a brief's midnight-UTC date always renders as its intended calendar day.
const editionFmt = new Intl.DateTimeFormat("en-US", {
  weekday: "long", month: "long", day: "numeric", year: "numeric", timeZone: "UTC",
});
const editionDateLine = editionFmt.format(briefs[0]?.data?.date ?? new Date());

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || "/og.png", Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Waynesville News" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Waynesville News Daily Brief (podcast)" href="/podcast.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Waynesville News" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {ogType === "article" && published && <meta property="article:published_time" content={published.toISOString().slice(0, 10)} />}
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLdBlocks.map((d) => <script type="application/ld+json" set:html={ldJson(d)} />)}

    {/* Self-hosted Newsreader (see the @font-face note in global.css). The
        wordmark and headings use 600, so it loads first. */}
    <link rel="preload" href="/fonts/newsreader-600.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    {/* Apply a saved light/dark choice before first paint (no flash). */}
    <script is:inline>try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {isDemoMode && <DemoBanner />}
    <Masthead dateLine={dateLine ?? editionDateLine} />
    {showInfoBar && <InfoBar />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
